{
  "name": "@openuji/recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end UXR capture session: fused streams through the rules engine into configured sinks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "uxr-record": "./dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@openuji/cli-kit": "workspace:*",
    "@openuji/core": "workspace:*",
    "@openuji/engine": "workspace:*",
    "@openuji/fused": "workspace:*",
    "@openuji/host-puppeteer": "workspace:*",
    "@openuji/privacy": "workspace:*",
    "@openuji/rules-document": "workspace:*",
    "@openuji/rules-interaction": "workspace:*",
    "@openuji/sinks": "workspace:*"
  }
}
