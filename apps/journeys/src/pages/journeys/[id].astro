---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { ReportReader } from '@openuji/design-system';
import Page from '../../layouts/Page.astro';
import { journeyMedia } from '../../lib/journey-store';
import { PROJECT_REPOSITORY } from '../../lib/site';

export const getStaticPaths = (async () => (await getCollection('journeys')).map(({ data }) => ({
  params: { id: data.id },
  props: { entry: data },
}))) satisfies GetStaticPaths;

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Page title={`${entry.title} — Journeys`} repositoryHref={PROJECT_REPOSITORY} repositoryLabel="Projekt auf GitHub öffnen">
  <ReportReader client:load entry={entry} media={journeyMedia(base, entry)} back={{ href: base, label: 'Journeys' }} repositoryHref={PROJECT_REPOSITORY} locale={{ language: 'de', dir: 'ltr' }} />
</Page>
