---
import { getCollection } from 'astro:content';
import { JourneyList } from '@journey-lines/design-system';
import Page from '../layouts/Page.astro';
import { journeyHref, newestFirst } from '../lib/journey-store';
import { PROJECT_REPOSITORY } from '../lib/site';

const journeys = (await getCollection('journeys')).map(({ data }) => data).sort(newestFirst);
const href = (id: string) => journeyHref(import.meta.env.BASE_URL, id);
---

<Page title="Journeys" repositoryHref={PROJECT_REPOSITORY} repositoryLabel="View project on GitHub">
  <JourneyList journeys={journeys} href={href} repositoryHref={PROJECT_REPOSITORY} />
</Page>
