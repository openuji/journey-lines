---
import { GitHubLink } from '@journey-lines/design-system';
import '@journey-lines/design-system/styles.css';

interface Props {
  title: string;
  repositoryHref: string;
  repositoryLabel: string;
}

const { title, repositoryHref, repositoryLabel } = Astro.props;
---

<!doctype html>
<html lang="en" data-color-mode="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <slot />
      <footer class="site-footer">
        <GitHubLink href={repositoryHref} label={repositoryLabel} />
      </footer>
    </div>
  </body>
</html>

<style>
  .site-shell {
    display: flex;
    flex-direction: column;
    min-height: var(--ds-viewport-height);
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--ds-report-bar-height);
    margin-top: auto;
    padding: var(--ds-space-4) var(--ds-report-side-padding);
    border-top: var(--ds-border-thin) solid var(--ds-color-line);
  }
</style>
