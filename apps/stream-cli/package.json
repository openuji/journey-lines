{
  "name": "@openuji/stream-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dev runners: each CDP source on its own, and the fused detection pipeline — live in the terminal, no disk writes.",
  "files": ["dist", "privacy"],
  "scripts": {
    "uxr-privacy": "pnpm -w run build && node dist/privacy.js",
    "build": "tsc --build",
    "uxr-stream-compositor": "pnpm run build && node dist/compositor.js",
    "uxr-stream-lifecycle": "pnpm run build && node dist/lifecycle.js",
    "uxr-stream-probe": "pnpm run build && node dist/probe.js",
    "uxr-stream-fused": "pnpm run build && node dist/fused.js"
  },
  "dependencies": {
    "@openuji/cli-kit": "workspace:*",
    "@openuji/core": "workspace:*",
    "@openuji/fused": "workspace:*",
    "@openuji/privacy": "workspace:*",
    "@openuji/sinks": "workspace:*",
    "@openuji/stream-compositor": "workspace:*",
    "@openuji/stream-probe": "workspace:*",
    "@openuji/stream-lifecycle": "workspace:*"
  }
}
