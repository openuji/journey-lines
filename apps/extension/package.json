{
  "name": "@journey-lines/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension host: records the user's own tab through chrome.debugger and shows the journey live in a side panel.",
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "dev": "wxt",
    "build": "wxt build",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@journey-lines/cdp": "workspace:*",
    "@journey-lines/clip-webm": "workspace:*",
    "@journey-lines/core": "workspace:*",
    "@journey-lines/design-system": "workspace:*",
    "@journey-lines/fused": "workspace:*",
    "@journey-lines/host-extension": "workspace:*",
    "@journey-lines/journey": "workspace:*",
    "@journey-lines/privacy": "workspace:*",
    "@journey-lines/rules-document": "workspace:*",
    "@journey-lines/rules-interaction": "workspace:*",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/chrome": "0.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "esbuild": "0.28.2",
    "puppeteer": "25.12.0",
    "storybook": "^10.6.1",
    "typescript": "^5.7.2",
    "vite": "8.3.2",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
