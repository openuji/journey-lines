{
  "name": "@openuji/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension host: records the user's own tab through chrome.debugger and shows the journey live in a side panel.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@openuji/cdp": "workspace:*",
    "@openuji/core": "workspace:*",
    "@openuji/fused": "workspace:*",
    "@openuji/host-extension": "workspace:*",
    "@openuji/rules-document": "workspace:*",
    "@openuji/rules-interaction": "workspace:*",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "esbuild": "0.28.2",
    "puppeteer": "25.12.0",
    "typescript": "^5.7.2",
    "vite": "8.3.2",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
