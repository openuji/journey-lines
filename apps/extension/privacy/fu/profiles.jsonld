{
  "@context": [
    "https://ujg.specs.openuji.org/ed/ns/context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/surface.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/l10n.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/observability.context.jsonld"
  ],
  "@id": "urn:privacy:fu:profiles",
  "@type": "UJGDocument",
  "extensions": {
    "org.openuji.privacy": {
      "id": "fu",
      "version": "0.1.0-collected",
      "scopes": [
        {
          "id": "scope-1enzo9o",
          "origin": "https://identity.fu-berlin.de",
          "path": {
            "prefix": "/idp-fub/profile/SAML2/Redirect"
          }
        },
        {
          "id": "scope-xxo1vw",
          "origin": "https://my.fu-berlin.de",
          "path": {
            "prefix": "/"
          }
        }
      ],
      "rules": [
        {
          "id": "fu.login-username",
          "scopeRefs": [
            "scope-1enzo9o"
          ],
          "locatorRef": "urn:privacy:fu:login-username",
          "action": "mask-input"
        },
        {
          "id": "fu.a",
          "scopeRefs": [
            "scope-xxo1vw"
          ],
          "locatorRef": "urn:privacy:fu:a",
          "action": "replace-text",
          "replacement": "Max Mustermann (max-muster)",
          "text": {
            "kind": "leaf"
          }
        }
      ],
      "metadata": []
    }
  },
  "nodes": [
    {
      "@id": "urn:privacy:fu:login-username",
      "@type": "CustomLocator",
      "extensions": {
        "org.openuji.privacy.css": {
          "selector": "#username"
        }
      }
    },
    {
      "@id": "urn:privacy:fu:a",
      "@type": "CustomLocator",
      "extensions": {
        "org.openuji.privacy.css": {
          "selector": "div.myfu-user > a"
        }
      }
    }
  ]
}
