{
  "name": "chromium-watch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UXR interaction & visual stream capture \u2014 fused CDP event streams",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openuji/recorder.git"
  },
  "homepage": "https://github.com/openuji/recorder#readme",
  "bugs": {
    "url": "https://github.com/openuji/recorder/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build:probe": "pnpm --filter @openuji/client-probe run build:source",
    "build": "pnpm run build:browser && tsc --build",
    "typecheck": "pnpm run build && pnpm -r run typecheck && tsc --noEmit -p tsconfig.test.json",
    "clean": "tsc --build --clean",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "pnpm run build:browser && vitest run",
    "test:watch": "pnpm run build:browser && vitest",
    "test:browser": "pnpm run build && pnpm run build:extension && pnpm run build:privacy-collector:test && vitest run -c vitest.browser.config.ts",
    "start": "pnpm run build && node apps/recorder/dist/cli.js",
    "dev:compositor": "pnpm run build && node apps/stream-cli/dist/compositor.js",
    "dev:lifecycle": "pnpm run build && node apps/stream-cli/dist/lifecycle.js",
    "dev:probe": "pnpm run build && node apps/stream-cli/dist/probe.js",
    "dev:fused": "pnpm run build && node apps/stream-cli/dist/fused.js",
    "dev:extension": "pnpm run build:browser && pnpm --filter @openuji/extension dev",
    "dev:privacy-collector": "pnpm --filter @openuji/privacy-collector dev",
    "build:extension": "pnpm run build:browser && pnpm --filter @openuji/extension build",
    "build:privacy-collector": "pnpm --filter @openuji/privacy-collector build",
    "build:privacy-collector:test": "PRIVACY_COLLECTOR_TEST_HOST=http://127.0.0.1/* pnpm --filter @openuji/privacy-collector build",
    "storybook:extension": "pnpm --filter @openuji/extension storybook",
    "build:storybook": "pnpm --filter @openuji/extension build-storybook",
    "build:privacy": "pnpm --filter @openuji/privacy run build:source",
    "build:browser": "pnpm run build:probe && pnpm run build:privacy",
    "dev:privacy": "pnpm run build && node apps/stream-cli/dist/privacy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "puppeteer": "25.12.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
