{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node", "vitest/globals", "chrome"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "paths": {
      "@journey-lines/privacy": ["./packages/privacy/src/index.ts"],
      "@journey-lines/cdp": ["./packages/cdp/src/index.ts"],
      "@journey-lines/cdp/testing": ["./packages/cdp/src/testing.ts"],
      "@journey-lines/client-probe": ["./packages/client/probe/src/index.ts"],
      "@journey-lines/clip-webm": ["./packages/clip-webm/src/index.ts"],
      "@journey-lines/core": ["./packages/core/src/index.ts"],
      "@journey-lines/core/wire": ["./packages/core/src/wire.ts"],
      "@journey-lines/design-system": ["./packages/design-system/src/index.ts"],
      "@journey-lines/engine": ["./packages/engine/src/index.ts"],
      "@journey-lines/fused": ["./packages/fused/src/index.ts"],
      "@journey-lines/host-extension": ["./packages/host-extension/src/index.ts"],
      "@journey-lines/host-puppeteer": ["./packages/host-puppeteer/src/index.ts"],
      "@journey-lines/journey": ["./packages/journey/src/index.ts"],
      "@journey-lines/journey/fixtures": ["./packages/journey/src/fixtures/index.ts"],
      "@journey-lines/rules-document": ["./packages/rules-document/src/index.ts"],
      "@journey-lines/rules-interaction": ["./packages/rules-interaction/src/index.ts"],
      "@journey-lines/sinks": ["./packages/sinks/src/index.ts"],
      "@journey-lines/stream-compositor": ["./packages/stream-compositor/src/index.ts"],
      "@journey-lines/stream-probe": ["./packages/stream-probe/src/index.ts"],
      "@journey-lines/stream-lifecycle": ["./packages/stream-lifecycle/src/index.ts"],
      "@journey-lines/stream-html": ["./packages/stream-html/src/index.ts"],
      "@journey-lines/stream-pdf": ["./packages/stream-pdf/src/index.ts"]
    }
  },
  "include": [
    "packages/**/test/**/*.ts",
    "apps/**/test/**/*.ts",
    "apps/extension/src/ui/**/*.d.ts",
    "packages/design-system/src/ui/**/*.d.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "workspace-aliases.ts",
    "vitest.browser.config.ts"
  ]
}
