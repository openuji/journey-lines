{
  "name": "@journey-lines/fused",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orchestrator: fuses the three CDP sources into one ordered domain event stream, and runs it through the rules engine into sinks.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@journey-lines/cdp": "workspace:*",
    "@journey-lines/core": "workspace:*",
    "@journey-lines/engine": "workspace:*",
    "@journey-lines/rules-document": "workspace:*",
    "@journey-lines/rules-interaction": "workspace:*",
    "@journey-lines/stream-compositor": "workspace:*",
    "@journey-lines/stream-html": "workspace:*",
    "@journey-lines/stream-lifecycle": "workspace:*",
    "@journey-lines/stream-pdf": "workspace:*"
  }
}
